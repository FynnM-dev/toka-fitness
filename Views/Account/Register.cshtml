@model User;

@{
    ViewData["Title"] = "Create an Account";
}

<h1 class="display-5 mb-3">Register an account</h1>

<div class="card shadow w-50 mx-auto">
    <div class="card-body">
        @* Show the user a warning message or a success message if there is one *@
        @if (ViewBag.ErrorMessage != null && ViewBag.SuccessMessage == null)
        {
            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
        }

        @if (ViewBag.SuccessMessage != null && ViewBag.ErrorMessage == null)
        {
            <div class="alert alert-success">@ViewBag.SuccessMessage</div>
        }

        @* This form gathers the inputs for user model *@
        <form method="post" asp-controller="Account">
            <div class="form-group">
                <label asp-for="Username"></label>
                <input class="form-control" asp-for="Username" />
                <span class="text-danger" asp-validation-for="Username"></span>
            </div>

            <div class="form-group mt-3">
                <label asp-for="Email"></label>
                <input class="form-control" asp-for="Email" />
                <span class="text-danger" asp-validation-for="Email"></span>
            </div>

            <div class="form-group mt-3">
                <label asp-for="Password"></label>
                <input type="password" id="passInput" class="form-control" asp-for="Password" />
                <span class="text-danger" asp-validation-for="Password"></span>
            </div>

            @* Checkbox that unhides the password input using JS *@
            <div class="form-check mt-3">
                <input class="form-check-input" id="unhidePassCheck" type="checkbox" onclick="unhidePass()" />
                <label class="form-check-label" for="unhidePassCheck">Show Password</label>
            </div>

            <button class="btn btn-primary mt-3 mx-auto" type="submit">Register</button>
        </form>

    </div>
</div>